---
// Imported first: Astro orders page stylesheets by import position, and games.css
// (imported by GameDirectory/GamePage) must come after the base styles.
import '../styles/site.css';
import bricolage from '../styles/fonts/BricolageGrotesque-Bold.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { routes, type Language, type Page, type Translations } from '../data/navigation';
import { appStoreId } from '../data/stores';
import { jsonForScript, mobileApplication } from '../data/structuredData';
interface Props { lang: Language; page: Page; title: string; description: string; translations?: Translations }
const { lang, page, title, description, translations } = Astro.props;
const notFound = page === 'notFound';
const translated = translations ?? (page === 'notFound' || page === 'game' ? null : routes[page]);
if (!notFound && !translated) throw new Error('A translated route is required for each public page.');
const absolute = (path: string) => new URL(path, Astro.site).href;
const canonical = absolute(notFound ? '/404.html' : translated![lang]);
const locales = { es: 'es_ES', eu: 'eu_ES' } as const;
const alternateLocale = locales[lang === 'es' ? 'eu' : 'es'];
// 1200 × 630 (1.91:1) so summary_large_image previews are not cropped.
const shareImage = { url: absolute('/assets/share-wide.png'), width: 1200, height: 630 };
const structuredData = page === 'home'
  ? jsonForScript(mobileApplication({ url: canonical, description, image: absolute('/assets/app-icon.png') }))
  : null;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" content="#f7f3ec" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {notFound ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {translated && <>
      <link rel="alternate" hreflang="es" href={absolute(translated.es)} />
      <link rel="alternate" hreflang="eu" href={absolute(translated.eu)} />
      <link rel="alternate" hreflang="x-default" href={absolute(translated.es)} />
    </>}
    <meta name="apple-itunes-app" content={`app-id=${appStoreId}`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Euskalario" />
    <meta property="og:locale" content={locales[lang]} />
    {translated && <meta property="og:locale:alternate" content={alternateLocale} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage.url} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(shareImage.width)} />
    <meta property="og:image:height" content={String(shareImage.height)} />
    <meta property="og:image:alt" content={lang === 'es' ? 'Euskalario y su mascota con el lema «Euskara, jolasean».' : 'Euskalarioren izena eta maskota, «Euskara, jolasean» leloarekin.'} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/png" href="/assets/favicon.png" />
    <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />
    <link rel="preload" href={bricolage} as="font" type="font/woff2" crossorigin />
    {structuredData && <script is:inline type="application/ld+json" set:html={structuredData} />}
    {page === 'home' && lang === 'es' && <script is:inline type="application/ld+json" set:html={jsonForScript({
      '@context': 'https://schema.org', '@type': 'WebSite', name: 'Euskalario', url: absolute('/'),
    })} />}
    <slot name="head" />
  </head>
  <body>
    <!--email_off-->
    <Header lang={lang} page={page} translations={translated ?? undefined} />
    <slot />
    <Footer lang={lang} page={page} />
    <!--/email_off-->
  </body>
</html>
