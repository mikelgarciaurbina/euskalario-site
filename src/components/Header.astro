---
import { navigation, routes, type Language, type Page, type Translations } from '../data/navigation';
interface Props { lang: Language; page: Page; translations?: Translations }
const { lang, page, translations } = Astro.props;
const labels = navigation[lang];
const translated = translations ?? routes[page === 'notFound' || page === 'game' ? 'home' : page];
---
<a class="skip" href="#content">{labels.skip}</a>
<header class="site-header">
  <div class="wrap">
    <a class="brand" href={routes.home[lang]}>
      <img src="/assets/logo.svg" width="174" height="41" alt={labels.home} />
    </a>
    <nav class="nav" aria-label={labels.label}>
      <a class="nav-games" href={`${routes.home[lang]}#juegos`}>{labels.games}</a>
      <a href={routes.support[lang]} aria-current={page === 'support' ? 'page' : undefined}>{labels.support}</a>
    </nav>
    <nav class="languages" aria-label={labels.languages}>
      <a href={translated.es} lang="es" hreflang="es" aria-current={page !== 'notFound' && lang === 'es' ? 'page' : undefined}>Español</a>
      <a href={translated.eu} lang="eu" hreflang="eu" aria-current={page !== 'notFound' && lang === 'eu' ? 'page' : undefined}>Euskara</a>
    </nav>
  </div>
</header>
