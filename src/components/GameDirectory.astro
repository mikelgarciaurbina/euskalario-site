---
import { games, gamePath } from '../data/games';
import type { Language } from '../data/navigation';
import '../styles/games.css';
interface Props { lang: Language }
const { lang } = Astro.props;
---
<ul class="game-list" role="list">
  {games.map((game) => (
    <li class={`game game-link game-${game.id}`}>
      <h3><a href={gamePath(game, lang)} lang="eu">{game.name}</a></h3>
      <p>{game[lang].summary}</p>
    </li>
  ))}
</ul>
