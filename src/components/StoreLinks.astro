---
import { stores } from '../data/stores';
import type { Language } from '../data/navigation';
interface Props { lang: Language }
const { lang } = Astro.props;
const label = lang === 'es' ? 'Descargar Euskalario' : 'Deskargatu Euskalario';
---
<div class="store-links" role="group" aria-label={label}>
  {stores.map((store) => (
    <a class="store-link" href={store.url}>
      <span><small>{lang === 'es' ? 'Descargar en' : 'Deskargatu'}</small><strong>{lang === 'eu' ? `${store.name}tik` : store.name}</strong></span>
    </a>
  ))}
</div>
